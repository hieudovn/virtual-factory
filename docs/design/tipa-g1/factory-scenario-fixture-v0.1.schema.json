{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorix.vn/contracts/vf/tipa-g1/factory-scenario-fixture-v0.1.schema.json",
  "title": "factory-scenario-fixture-v0.1.schema.json",
  "description": "SA DETAIL DRAFT: contract-level deterministic scenarios; expected sequence is an oracle proposal, not CI-backed runtime evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "fixture_id",
    "run_header",
    "modules",
    "events",
    "oracles",
    "known_limitations"
  ],
  "properties": {
    "contract_version": {
      "const": "vf-scenario-fixture-v0.1"
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "run_header": {
      "$ref": "factory-run-v0.1.schema.json"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "module-manifest-v0.1.schema.json"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tick_us",
          "module_id",
          "action",
          "subject_id"
        ],
        "properties": {
          "tick_us": {
            "type": "integer",
            "minimum": 0
          },
          "module_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "action": {
            "enum": [
              "PRODUCE",
              "RECEIVE",
              "REQUEST_JOIN",
              "START_JOIN",
              "COMPLETE_JOIN",
              "OUTAGE_START",
              "OUTAGE_END",
              "WAIT_FOR_MATERIAL",
              "QUALITY_BLOCK"
            ]
          },
          "subject_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "oracles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "expected": {
            "type": [
              "string",
              "number",
              "boolean",
              "object"
            ]
          }
        }
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
