{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtual-factory.ai-harness/schemas/acceptance.schema.json",
  "title": "Acceptance Criteria Schema",
  "description": "Defines acceptance criteria items for task evaluation.",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean", "default": true },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
